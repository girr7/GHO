# Binance API credentials
# Get them from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Use testnet (true/false)
USE_TESTNET=true

# Trading pair (e.g. BTCUSDT, ETHUSDT, BNBUSDT)
TRADING_PAIR=BTCUSDT

# Quote asset to trade with (e.g. USDT)
QUOTE_ASSET=USDT

# Amount per trade in quote asset (e.g. 50 = $50 USDT per trade)
TRADE_AMOUNT=50

# Strategy: rsi, ma_crossover, combined
STRATEGY=combined

# Risk management
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=4.0
MAX_OPEN_TRADES=3

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
